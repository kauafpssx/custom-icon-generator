{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "includeFiles": "node_modules/@resvg/resvg-js/**,node_modules/simple-icons/**"
    }
  },
  "rewrites": [
    { "source": "/api/asset/:slug*", "destination": "/api/index?slug=:slug*" },
    { "source": "/api/search",       "destination": "/api/index?action=search" },
    { "source": "/api/icons/all",    "destination": "/api/index?action=icons-all" },
    { "source": "/api/icons",        "destination": "/api/index?action=icons" },
    { "source": "/api/:path*",       "destination": "/api/index" },
    { "source": "/((?!api/).*)",     "destination": "/index.html" }
  ]
}
